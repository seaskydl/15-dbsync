class A:
  def __init__(self, value):
    print('A initial')
    self.a = value

class B:
  def __init__(self, value):
    print('B initial')
    self.b = value


class C(A, B):
  def __init__(self):
    A.__init__(self, 1)
    B.__init__(self, 2)

if __name__ == "__main__":
  c = C()
  print(c.a, c.b)